# Copy to .env before filling in provider keys.
# docker compose up works without this file; containers override the
# database and Redis hosts. Use these localhost URLs when running a
# service on the host against published ports.

# Postgres
POSTGRES_USER=campfire
POSTGRES_PASSWORD=campfire
POSTGRES_DB=campfire
DATABASE_URL=postgresql://campfire:campfire@localhost:5432/campfire

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# App
SECRET_KEY=change-me
PUBLIC_APP_URL=http://localhost:5173
MEDIA_DIR=./media
EMBEDDING_DIM=1536
DEFAULT_TRIP_TIMEZONE=America/Los_Angeles
RECAP_HOUR=21

# ChatGPT — narration, story structure, sentiment, inside jokes
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# ElevenLabs — speech to text for voice notes, and speech for narration
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_WOMAN=bD9maNcCuQQS75DGuteM
ELEVENLABS_VOICE_MAN=HIGUfNOdjuWQwwapnTRW
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STT_MODEL_ID=scribe_v2

# Backboard — cross-trip memory (jokes, nicknames, sentiment)
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=

# Unused by the illustrated playback map.
GOOGLE_MAPS_API_KEY=

# WhatsApp service
WHATSAPP_AUTH_DIR=auth
LOG_LEVEL=info
