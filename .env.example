# Copy to .env before filling in provider keys.
# docker compose up works without this file; containers override the
# database and Redis hosts. Use these localhost URLs when running a
# service on the host against published ports.

# Postgres
POSTGRES_USER=campfire
POSTGRES_PASSWORD=campfire
POSTGRES_DB=campfire
DATABASE_URL=postgresql://campfire:campfire@localhost:5432/campfire

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# App
SECRET_KEY=change-me
PUBLIC_APP_URL=http://localhost:5173
MEDIA_DIR=./media
EMBEDDING_DIM=1536
DEFAULT_TRIP_TIMEZONE=America/Los_Angeles
RECAP_HOUR=21

# Claude — narration, story structure, sentiment, inside jokes
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Whisper — voice note transcription (OpenAI audio API)
OPENAI_API_KEY=

# ElevenLabs — narration scripts to speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Backboard — cross-trip memory (jokes, nicknames, sentiment)
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=

# Google Maps JavaScript API — Around the Campfire playback
GOOGLE_MAPS_API_KEY=

# WhatsApp service
WHATSAPP_AUTH_DIR=auth
LOG_LEVEL=info
