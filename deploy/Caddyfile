{$DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy backend:5000
	}

	# Vite fingerprints these files. They can stay cached.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# index.html (and client-side routes that fall back to it) must
	# revalidate, or browsers keep the previous bundle.
	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
