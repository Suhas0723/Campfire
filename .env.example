# Copy to .env before filling in provider keys.
# docker compose up works without this file; containers override the
# database and Redis hosts. Use these localhost URLs when running a
# service on the host against published ports.

# Postgres
POSTGRES_USER=campfire
POSTGRES_PASSWORD=campfire
POSTGRES_DB=campfire
DATABASE_URL=postgresql://campfire:campfire@localhost:5432/campfire

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# App
# On the VPS, replace SECRET_KEY and set PUBLIC_APP_URL to https://your-domain.
SECRET_KEY=change-me
PUBLIC_APP_URL=http://localhost:5173
MEDIA_DIR=./media
EMBEDDING_DIM=1536
DEFAULT_TRIP_TIMEZONE=America/Los_Angeles
RECAP_HOUR=21
BOOKING_CUTOFF_HOUR=9
BOOKING_CURRENCY=USD
ACTIVITY_PROVIDER=mock
PAYMENT_PROVIDER=mock_vic
# Demo failure/repricing controls.
MOCK_ACTIVITY_REPRICE_DELTA=0
MOCK_VIC_DECLINE=false

# Sandbox purchases. Leave the providers above as mock unless these are set.
# Visa Acceptance holds test funds (auth only, never captured) and reverses the
# hold if the Viator booking fails. Viator does not charge that Visa credential.
# PAYMENT_PROVIDER=visa_acceptance also needs an enrolled instrument id stored
# as PaymentToken.token_ref. Intelligent Commerce still requires passkey
# enrollment on the Visa sandbox; a missing enrollment declines the booking.
VISA_ACCEPTANCE_MERCHANT_ID=
VISA_ACCEPTANCE_KEY_ID=
VISA_ACCEPTANCE_SHARED_SECRET=
VISA_ACCEPTANCE_HOST=apitest.visaacceptance.com
VISA_ACCEPTANCE_TOKENIZED_CARD=
# ACTIVITY_PROVIDER=viator needs a Merchant or Full-access + Booking key to confirm.
VIATOR_API_KEY=
VIATOR_API_BASE_URL=https://api.sandbox.viator.com/partner
VIATOR_BOOKER_EMAIL=
VIATOR_BOOKER_FIRST_NAME=
VIATOR_BOOKER_LAST_NAME=
VIATOR_BOOKER_PHONE=

# Sign-in. DEMO_MODE=true skips WhatsApp, accepts the code 000000, logs the
# real code, and seeds demo users Priya/Dev/Marcus (+1 555 010 0001..0003).
DEMO_MODE=false
# Set both to true when the app is served over HTTPS (docker-compose.prod.yml).
SESSION_COOKIE_SECURE=false
BEHIND_PROXY=false

# ChatGPT — narration, story structure, sentiment, inside jokes
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# ElevenLabs — speech to text for voice notes, and speech for narration
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_WOMAN=bD9maNcCuQQS75DGuteM
ELEVENLABS_VOICE_MAN=HIGUfNOdjuWQwwapnTRW
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STT_MODEL_ID=scribe_v2

# Backboard — cross-trip memory (jokes, nicknames, sentiment)
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=

# Muse Spark (Meta Model API) — vibe-aware local suggestions in nightly recaps
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.1

# Unused by the illustrated playback map.
GOOGLE_MAPS_API_KEY=

# WhatsApp service
WHATSAPP_AUTH_DIR=auth
LOG_LEVEL=info

# Production (docker-compose.prod.yml on a Vultr VPS).
# Hostname only, no scheme. A second name is allowed: example.com, www.example.com
# Then set PUBLIC_APP_URL=https://example.com, SESSION_COOKIE_SECURE=true,
# BEHIND_PROXY=true, and a long random SECRET_KEY.
# Compose still points Postgres and Redis at the Docker network. Do not
# change DATABASE_URL or REDIS_URL to localhost on the VPS.
DOMAIN=
